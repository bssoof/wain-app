[2026-05-07T22:26:19.950Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/wain-d2e28/rulesets {"name":"projects/wain-d2e28/rulesets/3efdaa99-c6eb-49e7-8657-a3c19a910541","source":{"files":[{"content":"rules_version = '2';\r\nservice firebase.storage {\r\n  match /b/{bucket}/o {\r\n    \r\n    // Helper: Valid Image Check (Type & Size)\r\n    function isValidImage() {\r\n      return request.resource != null\r\n             && request.resource.contentType.matches('image/.*')\r\n             && request.resource.size < 5 * 1024 * 1024; // 5MB\r\n    }\r\n\r\n    function isValidStoryMedia() {\r\n      return request.resource != null\r\n             && (\r\n               (\r\n                 request.resource.contentType.matches('image/.*')\r\n                 && request.resource.size < 5 * 1024 * 1024\r\n               )\r\n               || (\r\n                 request.resource.contentType.matches('video/.*')\r\n                 && request.resource.size < 50 * 1024 * 1024\r\n               )\r\n             );\r\n    }\r\n\r\n    function hasUserVenueLink(venueId) {\r\n      return request.auth != null\r\n             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))\r\n             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.merchant_venue_id == venueId;\r\n    }\r\n\r\n    function hasMerchantVenueLink(venueId) {\r\n      return request.auth != null\r\n             && firestore.exists(/databases/(default)/documents/merchants/$(request.auth.uid))\r\n             && firestore.get(/databases/(default)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return request.auth != null\r\n             && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))\r\n             && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active != false;\r\n    }\r\n    \r\n    // Helper: Check Ownership via Firestore\r\n    // Cost: 1 Document Read per write request.\r\n    function isVenueOwner(venueId) {\r\n       return hasUserVenueLink(venueId) || hasMerchantVenueLink(venueId);\r\n    }\r\n\r\n    match /venues/{venueId}/photos/{fileName} {\r\n       // Anyone can view\r\n       allow read: if true;\r\n       \r\n       // Upload/Update: Check Image + Owner\r\n       allow create, update: if request.auth != null\r\n                             && isValidImage()\r\n                      && (isVenueOwner(venueId) || isAdmin());\r\n                             \r\n       // Delete: Check Owner only (no image validation needed)\r\n       allow delete: if request.auth != null\r\n                && (isVenueOwner(venueId) || isAdmin());\r\n     }\r\n\r\n     match /venues/{venueId}/menu_images/{fileName} {\r\n       allow read: if true;\r\n\r\n       allow create, update: if request.auth != null\r\n                      && isValidImage()\r\n                      && (isVenueOwner(venueId) || isAdmin());\r\n\r\n       allow delete: if request.auth != null\r\n                && (isVenueOwner(venueId) || isAdmin());\r\n    }\r\n\r\n    match /venues/{venueId}/stories/{fileName} {\r\n       allow read: if true;\r\n\r\n       allow create, update: if request.auth != null\r\n                             && isValidStoryMedia()\r\n                             && isVenueOwner(venueId);\r\n\r\n       allow delete: if request.auth != null\r\n                     && isVenueOwner(venueId);\r\n    }\r\n\r\n    match /venues/{venueId}/wallet_topups/{fileName} {\r\n       allow read: if request.auth != null && (isVenueOwner(venueId) || isAdmin());\r\n\r\n       allow create, update: if request.auth != null\r\n                             && isValidImage()\r\n                             && isVenueOwner(venueId);\r\n\r\n       allow delete: if request.auth != null\r\n                     && isVenueOwner(venueId);\r\n    }\r\n\r\n    // Default: Block all other writes\r\n    match /{allPaths=**} {\r\n      allow read: if false;\r\n      allow write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"storage.rules"}]},"createTime":"2026-05-07T22:26:20.035407Z","metadata":{"services":["firebase.storage"]}}
