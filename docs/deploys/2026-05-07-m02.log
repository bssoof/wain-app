[2026-05-07T22:52:18.692Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/wain-d2e28/rulesets {"name":"projects/wain-d2e28/rulesets/5bb3bdff-2953-43b0-ab02-4ab92b851cb7","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function hasActiveAdminDoc() {\r\n      return request.auth != null\r\n             && exists(/databases/$(database)/documents/admins/$(request.auth.uid))\r\n             && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false;\r\n    }\r\n\r\n    function isAdminUser() {\r\n      return hasActiveAdminDoc();\r\n    }\r\n\r\n    function isSuperAdmin() {\r\n      return request.auth != null\r\n             && hasActiveAdminDoc()\r\n             && (\r\n               request.auth.token.super_admin == true\r\n               || request.auth.token.role == \"super_admin\"\r\n               || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == \"super_admin\"\r\n               || (\r\n                 ('roles' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)\r\n                 && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.roles is list\r\n                 && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.roles.hasAny([\"super_admin\"])\r\n               )\r\n             );\r\n    }\r\n\r\n    // ============ ADMIN APP CONFIG ============\r\n    match /app_config/{configId} {\r\n      allow read: if configId == \"admin_step_up\" && isAdminUser();\r\n      allow create, update: if configId == \"admin_step_up\" && isSuperAdmin();\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /admin_step_up_audit_events/{eventId} {\r\n      allow read: if isSuperAdmin();\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // ============ USERS ============\r\n    match /users/{userId} {\r\n      // Helper: Check if keys are within whitelist\r\n      function hasOnlyAllowedKeys(allowedKeys) {\r\n        return request.resource.data.keys().hasOnly(allowedKeys);\r\n      }\r\n\r\n      // Helper: Check if only allowed keys are modified\r\n      function affectedKeysHasOnly(allowedKeys) {\r\n        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);\r\n      }\r\n\r\n      // 1. CREATE\r\n      allow create: if request.auth != null && request.auth.uid == userId\r\n                    // Whitelist + Immutability Checks\r\n                      && hasOnlyAllowedKeys([\r\n                          'uid', 'created_at', 'is_anonymous', 'phone_number', 'email',\r\n                          'photo_url', 'display_name', 'username',\r\n                          'favorites', 'favorites_updated_at',\r\n                          'fcm_token', 'platform',\r\n                          'wallet_notifications_enabled',\r\n                          'wallet_expiry_reminders_enabled',\r\n                          'admin_wallet_notifications_enabled'\r\n                         ])\r\n                    // Data Validation\r\n                    && request.resource.data.uid == request.auth.uid\r\n                    && request.resource.data.created_at is timestamp\r\n                    && request.resource.data.created_at <= request.time;\r\n\r\n      // 2. UPDATE\r\n      allow update: if request.auth != null && request.auth.uid == userId\r\n                    // Strict Update Whitelist (Immutable: email, phone, uid, merchant_venue_id, is_merchant, reviews_count)\r\n                      && affectedKeysHasOnly([\r\n                          'photo_url', 'display_name', 'username',\r\n                          'favorites', 'favorites_updated_at',\r\n                          'fcm_token', 'fcm_token_updated_at', 'platform',\r\n                          'saved_offers', 'saved_offers_updated_at',\r\n                          'try_list', 'try_list_updated_at',\r\n                          'wallet_notifications_enabled',\r\n                          'wallet_expiry_reminders_enabled',\r\n                          'admin_wallet_notifications_enabled'\r\n                         ])\r\n                    // Validation\r\n                    && (\r\n                      !('favorites' in request.resource.data) || request.resource.data.favorites.size() <= 500\r\n                    );\r\n\r\n      // 3. READ\r\n      allow read: if request.auth != null && request.auth.uid == userId;\r\n\r\n      // Notifications subcollection: Allow read/update for owner only\r\n      match /notifications/{notificationId} {\r\n        // The userId variable is from parent match, so this checks:\r\n        // request.auth.uid == the {userId} in /users/{userId}/notifications\r\n        allow read, update: if request.auth != null && request.auth.uid == userId;\r\n        allow create, delete: if false; // System-only via Cloud Functions\r\n      }\r\n    }\r\n\r\n    // ============ USERNAMES ============\r\n    match /usernames/{username} {\r\n      allow read: if true;\r\n      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // ============ MERCHANTS ============\r\n    // STRICT: Created via Cloud Function (redeemInviteCode) ONLY.\r\n    // Client cannot create or update.\r\n    match /merchants/{merchantId} {\r\n      allow read: if request.auth != null && request.auth.uid == merchantId;\r\n      allow create, update, delete: if false;\r\n    }\r\n\r\n    // ============ MERCHANT INVITES ============\r\n    // STRICT: Cloud Functions Only (redeemInviteCode).\r\n    // No client access.\r\n    match /merchant_invites/{inviteId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // ============ STORIES ============\r\n    match /{path=**}/stories/{storyId} {\r\n      allow read: if true;\r\n    }\r\n\r\n    match /stories/{storyId} {\r\n      allow read: if true;\r\n      function isStoryVenueOwner() {\r\n        return request.auth != null\r\n               && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == resource.data.venue_id;\r\n      }\r\n\r\n      // Create: Merchant Owner Only\r\n      allow create: if request.auth != null\r\n                    // Must include venue_id matching their merchant profile\r\n                    && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    && request.resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id\r\n                    // Cannot set promoted_until (Server Side / Cloud Function only)\r\n                    && !('promoted_until' in request.resource.data);\r\n\r\n      // Delete: story creator OR venue owner merchant\r\n      allow delete: if request.auth != null\r\n                    && (\r\n                      resource.data.created_by == request.auth.uid\r\n                      || isStoryVenueOwner()\r\n                    );\r\n\r\n      // Update: creator or venue owner merchant (No promoted_until update)\r\n      allow update: if request.auth != null\r\n                    && (\r\n                      resource.data.created_by == request.auth.uid\r\n                      || isStoryVenueOwner()\r\n                    )\r\n                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoted_until']);\r\n    }\r\n\r\n    // ============ VENUES ============\r\n    match /venues/{venueId} {\r\n      function isVenueMerchantOwner() {\r\n        return request.auth != null\r\n               && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;\r\n      }\r\n      function isActiveMenuVersion(versionId) {\r\n        return exists(/databases/$(database)/documents/venues/$(venueId)/menu_versions/$(versionId))\r\n               && get(/databases/$(database)/documents/venues/$(venueId)/menu_versions/$(versionId)).data.status == 'active';\r\n      }\r\n\r\n      allow read: if true;\r\n\r\n      // Update: Owner Only\r\n      allow update: if isVenueMerchantOwner();\r\n\r\n      allow create, delete: if false;\r\n\r\n      // Menu config (draft pointer, migration status, publish metadata)\r\n      match /menu_config/{configId} {\r\n        allow read, create, update: if isVenueMerchantOwner();\r\n        allow delete: if false;\r\n      }\r\n\r\n      // New versioned menu model under venue\r\n      match /menu_versions/{versionId} {\r\n        allow read: if isVenueMerchantOwner() || resource.data.status == 'active';\r\n        allow create, update, delete: if isVenueMerchantOwner();\r\n\r\n        match /categories/{categoryId} {\r\n          allow read: if isVenueMerchantOwner() || isActiveMenuVersion(versionId);\r\n          allow create, update, delete: if isVenueMerchantOwner();\r\n        }\r\n\r\n        match /items/{itemId} {\r\n          allow read: if isVenueMerchantOwner() || isActiveMenuVersion(versionId);\r\n          allow create, update, delete: if isVenueMerchantOwner();\r\n        }\r\n      }\r\n\r\n      // Legacy structured menu path (kept for fallback/migration period)\r\n      match /menu_items/{itemId} {\r\n        allow read: if true;\r\n        allow create, update, delete: if isVenueMerchantOwner();\r\n      }\r\n\r\n      // Import jobs (merchant-scoped)\r\n      match /menu_import_jobs/{jobId} {\r\n        allow read: if isVenueMerchantOwner();\r\n        allow create: if isVenueMerchantOwner()\r\n                      && !request.resource.data.keys().hasAny(['input_files']);\r\n        allow update: if isVenueMerchantOwner()\r\n                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['input_files']);\r\n        allow delete: if false;\r\n      }\r\n\r\n      // Subcollection: Reviews\r\n        // Subcollection: Reviews\r\n      match /reviews/{reviewId} {\r\n        allow read: if true;\r\n        // User can create own review\r\n        allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;\r\n\r\n        // User update own review (but NOT merchant reply fields)\r\n        allow update: if request.auth != null &&\r\n                      resource.data.user_id == request.auth.uid &&\r\n                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['merchant_reply', 'merchant_reply_at', 'merchant_reply_by']);\r\n\r\n        // User delete own review\r\n        allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;\r\n\r\n        // Merchant Owner: update ONLY reply fields\r\n        allow update: if request.auth != null &&\r\n                      exists(/databases/$(database)/documents/merchants/$(request.auth.uid)) &&\r\n                      get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId &&\r\n                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['merchant_reply', 'merchant_reply_at', 'merchant_reply_by']);\r\n      }\r\n    }\r\n\r\n    // ============ OFFERS ============\r\n    match /offers/{offerId} {\r\n      allow read: if true;\r\n      // Server-maintained fields that clients must never set/update directly.\r\n      function touchesServerOfferFields() {\r\n        return request.resource.data.diff(resource.data)\r\n          .affectedKeys()\r\n          .hasAny([\r\n            'claims_count',\r\n            'redeemed_count',\r\n            'conversion_rate',\r\n            'last_redeemed_at',\r\n            'is_featured',\r\n            'featured_until'\r\n          ]);\r\n      }\r\n      function createsServerOfferFields() {\r\n        return request.resource.data.keys()\r\n          .hasAny([\r\n            'claims_count',\r\n            'redeemed_count',\r\n            'conversion_rate',\r\n            'last_redeemed_at',\r\n            'is_featured',\r\n            'featured_until'\r\n          ]);\r\n      }\r\n      // Merchant Owner Only\r\n      allow create, update, delete: if request.auth != null\r\n                    && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    && (\r\n                      (request.method == 'create'\r\n                        && request.resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id\r\n                        && !createsServerOfferFields())\r\n                      ||\r\n                      (request.method != 'create'\r\n                        && resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id\r\n                        && (request.method == 'delete' || !touchesServerOfferFields()))\r\n                    );\r\n    }\r\n\r\n    // ============ OFFER CLAIMS & VISITS ============\r\n    // Cloud Functions Only\r\n    match /offer_claims/{claimId} {\r\n      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;\r\n      allow write: if false;\r\n    }\r\n    match /visits/{visitId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    // ============ VENUE ANALYTICS ============\r\n    // Server-aggregated analytics — read-only for venue owner\r\n    match /venue_analytics/{venueId} {\r\n      function hasUserVenueLink() {\r\n        return exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/users/$(request.auth.uid))\r\n                    .data.merchant_venue_id == venueId;\r\n      }\r\n      function hasMerchantVenueLink() {\r\n        return exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    .data.venue_id == venueId;\r\n      }\r\n      allow read: if request.auth != null\r\n                  && (hasUserVenueLink() || hasMerchantVenueLink());\r\n      allow write: if false; // Cloud Functions only (aggregation)\r\n    }\r\n\r\n    // Daily analytics snapshots — read-only for venue owner\r\n    match /venue_analytics_daily/{venueId}/days/{dayId} {\r\n      function hasUserVenueLink() {\r\n        return exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/users/$(request.auth.uid))\r\n                    .data.merchant_venue_id == venueId;\r\n      }\r\n      function hasMerchantVenueLink() {\r\n        return exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    .data.venue_id == venueId;\r\n      }\r\n      allow read: if request.auth != null\r\n                  && (hasUserVenueLink() || hasMerchantVenueLink());\r\n      allow write: if false;\r\n    }\r\n\r\n    // Per-offer analytics snapshots — read-only for venue owner\r\n    match /venue_offer_analytics/{venueId}/offers/{offerId} {\r\n      function hasUserVenueLink() {\r\n        return exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/users/$(request.auth.uid))\r\n                    .data.merchant_venue_id == venueId;\r\n      }\r\n      function hasMerchantVenueLink() {\r\n        return exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n               && get(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    .data.venue_id == venueId;\r\n      }\r\n      allow read: if request.auth != null\r\n                  && (hasUserVenueLink() || hasMerchantVenueLink());\r\n      allow write: if false;\r\n    }\r\n\r\n    // Raw venue events — system-only (via Cloud Functions)\r\n    match /venue_busy_times/{venueId} {\r\n      allow read: if true;\r\n      allow write: if false;\r\n    }\r\n\r\n    match /venue_events/{eventId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n\r\n    // ============ NAVIGATION CLICKS ============\r\n    match /navigation_clicks/{clickId} {\r\n        allow create: if request.auth != null;\r\n        allow read, update, delete: if false;\r\n    }\r\n\r\n    // ============ WALLET & CREDIT ============\r\n    match /merchant_wallets/{venueId} {\r\n      allow read: if request.auth != null\r\n                  && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                  && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;\r\n      allow write: if false; // System only\r\n\r\n      match /entries/{entryId} {\r\n        allow read: if request.auth != null\r\n                    && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                    && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;\r\n        allow write: if false; // System only\r\n      }\r\n    }\r\n\r\n    match /merchant_topup_requests/{requestId} {\r\n      allow read: if request.auth != null\r\n                  && (\r\n                    (\r\n                      exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                      && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == resource.data.venue_id\r\n                    )\r\n                    || isAdminUser()\r\n                  );\r\n\r\n      allow create, update, delete: if false; // System / Admin only\r\n\r\n    }\r\n\r\n    match /wallet_feature_pricing/{configId} {\r\n      allow read: if true;\r\n      allow write: if false; // Admin only\r\n    }\r\n\r\n    match /merchant_wallet_reports/{venueId} {\r\n      allow read: if request.auth != null\r\n                  && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))\r\n                  && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;\r\n      allow write: if false; // System aggregation only\r\n    }\r\n\r\n    match /wallet_audit_events/{eventId} {\r\n      allow read: if request.auth != null\r\n                  && isAdminUser();\r\n      allow write: if false; // System aggregation/audit only\r\n    }\r\n\r\n    match /wallet_notification_events/{eventId} {\r\n      allow read, write: if false; // System notification dedupe only\r\n    }\r\n\r\n    // ============ REVIEWS COLLECTION GROUP ============\r\n    match /{path=**}/reviews/{reviewId} {\r\n      allow read: if true;\r\n    }\r\n  }\r\n}\r\n/*\r\n============ REQUIRED INDEXES ============\r\n\r\nCreate these in Firebase Console > Firestore > Indexes:\r\n\r\n1. Collection: navigation_clicks\r\n   Fields: venue_id (Ascending), timestamp (Descending)\r\n   Query Scope: Collection\r\n\r\n2. Collection: navigation_clicks\r\n   Fields: user_id (Ascending), timestamp (Descending)\r\n   Query Scope: Collection\r\n\r\n============ HOW TO DEPLOY ============\r\n\r\nOption 1: Firebase Console\r\n- Copy the rules above\r\n- Go to Firebase Console > Firestore > Rules\r\n- Paste and click \"Publish\"\r\n\r\nOption 2: Firebase CLI\r\n- Save this file as 'firestore.rules' in project root\r\n- Run: firebase deploy --only firestore:rules\r\n\r\n*/\r\n","name":"firestore.rules"}]},"createTime":"2026-05-07T22:52:18.796207Z","metadata":{"services":["cloud.firestore"]}}
