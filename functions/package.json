{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "test:emulator:aggregate": "npm run build && firebase --config ../firebase.json emulators:exec --project demo-wain-analytics --only firestore \"node --test --test-concurrency=1 test/emulator/*.test.js\"",
    "quality:menu": "npm run build && firebase --config ../firebase.json emulators:exec --project demo-wain-analytics --only firestore \"node scripts/evaluate_menu_import_quality.js\"",
    "menu:migrate": "node scripts/migrate_legacy_menu_to_versioned.js",
    "menu:cleanup": "node scripts/cleanup_menu_versions_retention.js",
    "menu:clean-noise": "node scripts/cleanup_menu_import_noise.js",
    "transport:seed": "node scripts/seed_transport_mvp.js",
    "wallet:seed-config": "node scripts/seed_wallet_config.js",
    "wallet:verify-env": "node scripts/verify_wallet_env.js",
    "wallet:staging-rehearsal": "node scripts/run_wallet_staging_rehearsal.js",
    "admin-web:staging-rehearsal": "node scripts/run_admin_web_staging_rehearsal.js",
    "admin-web:audit-admin-roles": "node scripts/audit_admin_roles.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "acorn": "^8.16.0",
    "firebase": "^12.11.0",
    "markdown-it": "^14.1.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
