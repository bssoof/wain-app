rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============ USERS ============
    match /users/{userId} {
      // Helper: Check if keys are within whitelist
      function hasOnlyAllowedKeys(allowedKeys) {
        return request.resource.data.keys().hasOnly(allowedKeys);
      }
      
      // Helper: Check if only allowed keys are modified
      function affectedKeysHasOnly(allowedKeys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
      }

      // 1. CREATE
      allow create: if request.auth != null && request.auth.uid == userId
                    // Whitelist + Immutability Checks
                    && hasOnlyAllowedKeys([
                        'uid', 'created_at', 'is_anonymous', 'phone_number', 'email', 
                        'photo_url', 'display_name', 'username', 
                        'favorites', 'favorites_updated_at', 
                        'fcm_token', 'platform'
                       ])
                    // Data Validation
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.created_at is timestamp
                    && request.resource.data.created_at <= request.time;

      // 2. UPDATE
      allow update: if request.auth != null && request.auth.uid == userId
                    // Strict Update Whitelist (Immutable: email, phone, uid, merchant_venue_id, is_merchant, reviews_count)
                    && affectedKeysHasOnly([
                        'photo_url', 'display_name', 'username', 
                        'favorites', 'favorites_updated_at',
                        'fcm_token', 'fcm_token_updated_at', 'platform', 
                        'saved_offers', 'saved_offers_updated_at', 
                        'try_list', 'try_list_updated_at'
                       ])
                    // Validation
                    && (
                      !('favorites' in request.resource.data) || request.resource.data.favorites.size() <= 500
                    );

      // 3. READ
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Notifications subcollection: Allow read/update for owner only
      match /notifications/{notificationId} {
        // The userId variable is from parent match, so this checks:
        // request.auth.uid == the {userId} in /users/{userId}/notifications
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false; // System-only via Cloud Functions
      }
    }
    
    // ============ USERNAMES ============
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ============ MERCHANTS ============
    // STRICT: Created via Cloud Function (redeemInviteCode) ONLY.
    // Client cannot create or update.
    match /merchants/{merchantId} {
      allow read: if request.auth != null && request.auth.uid == merchantId;
      allow create, update, delete: if false;
    }

    // ============ MERCHANT INVITES ============
    // STRICT: Cloud Functions Only (redeemInviteCode).
    // No client access.
    match /merchant_invites/{inviteId} {
      allow read, write: if false;
    }

    // ============ STORIES ============
    match /{path=**}/stories/{storyId} {
      allow read: if true;
    }
    
    match /stories/{storyId} {
      allow read: if true;
      function isStoryVenueOwner() {
        return request.auth != null
               && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
               && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == resource.data.venue_id;
      }
      
      // Create: Merchant Owner Only
      allow create: if request.auth != null
                    // Must include venue_id matching their merchant profile
                    && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
                    && request.resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id
                    // Cannot set promoted_until (Server Side / Cloud Function only)
                    && !('promoted_until' in request.resource.data);

      // Delete: story creator OR venue owner merchant
      allow delete: if request.auth != null
                    && (
                      resource.data.created_by == request.auth.uid
                      || isStoryVenueOwner()
                    );

      // Update: creator or venue owner merchant (No promoted_until update)
      allow update: if request.auth != null
                    && (
                      resource.data.created_by == request.auth.uid
                      || isStoryVenueOwner()
                    )
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['promoted_until']);
    }

    // ============ VENUES ============
    match /venues/{venueId} {
      function isVenueMerchantOwner() {
        return request.auth != null
               && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
               && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;
      }
      function isActiveMenuVersion(versionId) {
        return exists(/databases/$(database)/documents/venues/$(venueId)/menu_versions/$(versionId))
               && get(/databases/$(database)/documents/venues/$(venueId)/menu_versions/$(versionId)).data.status == 'active';
      }

      allow read: if true;
      
      // Update: Owner Only
      allow update: if isVenueMerchantOwner();
      
      allow create, delete: if false;

      // Menu config (draft pointer, migration status, publish metadata)
      match /menu_config/{configId} {
        allow read, create, update: if isVenueMerchantOwner();
        allow delete: if false;
      }

      // New versioned menu model under venue
      match /menu_versions/{versionId} {
        allow read: if isVenueMerchantOwner() || resource.data.status == 'active';
        allow create, update, delete: if isVenueMerchantOwner();

        match /categories/{categoryId} {
          allow read: if isVenueMerchantOwner() || isActiveMenuVersion(versionId);
          allow create, update, delete: if isVenueMerchantOwner();
        }

        match /items/{itemId} {
          allow read: if isVenueMerchantOwner() || isActiveMenuVersion(versionId);
          allow create, update, delete: if isVenueMerchantOwner();
        }
      }

      // Legacy structured menu path (kept for fallback/migration period)
      match /menu_items/{itemId} {
        allow read: if true;
        allow create, update, delete: if isVenueMerchantOwner();
      }

      // Import jobs (merchant-scoped)
      match /menu_import_jobs/{jobId} {
        allow read, create, update: if isVenueMerchantOwner();
        allow delete: if false;
      }
      
      // Subcollection: Reviews
        // Subcollection: Reviews
      match /reviews/{reviewId} {
        allow read: if true;
        // User can create own review
        allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
        
        // User update own review (but NOT merchant reply fields)
        allow update: if request.auth != null && 
                      resource.data.user_id == request.auth.uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['merchant_reply', 'merchant_reply_at', 'merchant_reply_by']);
                      
        // User delete own review
        allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;

        // Merchant Owner: update ONLY reply fields
        allow update: if request.auth != null &&
                      exists(/databases/$(database)/documents/merchants/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['merchant_reply', 'merchant_reply_at', 'merchant_reply_by']);
      }
    }
    
    // ============ OFFERS ============
    match /offers/{offerId} {
      allow read: if true;
      // Server-maintained fields that clients must never set/update directly.
      function touchesServerOfferFields() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['claims_count', 'redeemed_count', 'conversion_rate', 'last_redeemed_at']);
      }
      function createsServerOfferFields() {
        return request.resource.data.keys()
          .hasAny(['claims_count', 'redeemed_count', 'conversion_rate', 'last_redeemed_at']);
      }
      // Merchant Owner Only
      allow create, update, delete: if request.auth != null
                    && exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
                    && (
                      (request.method == 'create'
                        && request.resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id
                        && !createsServerOfferFields())
                      ||
                      (request.method != 'create'
                        && resource.data.venue_id == get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.venue_id
                        && (request.method == 'delete' || !touchesServerOfferFields()))
                    );
    }
    
    // ============ OFFER CLAIMS & VISITS ============
    // Cloud Functions Only
    match /offer_claims/{claimId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
    match /visits/{visitId} {
      allow read, write: if false;
    }
    
    // ============ VENUE ANALYTICS ============
    // Server-aggregated analytics — read-only for venue owner
    match /venue_analytics/{venueId} {
      function hasUserVenueLink() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
               && get(/databases/$(database)/documents/users/$(request.auth.uid))
                    .data.merchant_venue_id == venueId;
      }
      function hasMerchantVenueLink() {
        return exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
               && get(/databases/$(database)/documents/merchants/$(request.auth.uid))
                    .data.venue_id == venueId;
      }
      allow read: if request.auth != null
                  && (hasUserVenueLink() || hasMerchantVenueLink());
      allow write: if false; // Cloud Functions only (aggregation)
    }

    // Daily analytics snapshots — read-only for venue owner
    match /venue_analytics_daily/{venueId}/days/{dayId} {
      function hasUserVenueLink() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
               && get(/databases/$(database)/documents/users/$(request.auth.uid))
                    .data.merchant_venue_id == venueId;
      }
      function hasMerchantVenueLink() {
        return exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
               && get(/databases/$(database)/documents/merchants/$(request.auth.uid))
                    .data.venue_id == venueId;
      }
      allow read: if request.auth != null
                  && (hasUserVenueLink() || hasMerchantVenueLink());
      allow write: if false;
    }

    // Raw venue events — system-only (via Cloud Functions)
    match /venue_busy_times/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    match /venue_events/{eventId} {
      allow read, write: if false;
    }

    // ============ NAVIGATION CLICKS ============
    match /navigation_clicks/{clickId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false;
    }
    
    // ============ REVIEWS COLLECTION GROUP ============
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }
  }
}
/*
============ REQUIRED INDEXES ============

Create these in Firebase Console > Firestore > Indexes:

1. Collection: navigation_clicks
   Fields: venue_id (Ascending), timestamp (Descending)
   Query Scope: Collection

2. Collection: navigation_clicks
   Fields: user_id (Ascending), timestamp (Descending)
   Query Scope: Collection

============ HOW TO DEPLOY ============

Option 1: Firebase Console
- Copy the rules above
- Go to Firebase Console > Firestore > Rules
- Paste and click "Publish"

Option 2: Firebase CLI
- Save this file as 'firestore.rules' in project root
- Run: firebase deploy --only firestore:rules

*/
