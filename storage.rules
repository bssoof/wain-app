rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Valid Image Check (Type & Size)
    function isValidImage() {
      return request.resource != null
             && request.resource.contentType.matches('image/.*')
             && request.resource.size < 5 * 1024 * 1024; // 5MB
    }

    function isValidStoryMedia() {
      return request.resource != null
             && (
               (
                 request.resource.contentType.matches('image/.*')
                 && request.resource.size < 5 * 1024 * 1024
               )
               || (
                 request.resource.contentType.matches('video/.*')
                 && request.resource.size < 50 * 1024 * 1024
               )
             );
    }

    function hasUserVenueLink(venueId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.merchant_venue_id == venueId;
    }

    function hasMerchantVenueLink(venueId) {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/merchants/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/merchants/$(request.auth.uid)).data.venue_id == venueId;
    }

    function isAdmin() {
      return request.auth != null
             && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
             && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active != false;
    }
    
    // Helper: Check Ownership via Firestore
    // Cost: 1 Document Read per write request.
    function isVenueOwner(venueId) {
       return hasUserVenueLink(venueId) || hasMerchantVenueLink(venueId);
    }

    match /venues/{venueId}/photos/{fileName} {
       // Anyone can view
       allow read: if true;
       
       // Upload/Update: Check Image + Owner
       allow create, update: if request.auth != null
                             && isValidImage()
                      && (isVenueOwner(venueId) || isAdmin());
                             
       // Delete: Check Owner only (no image validation needed)
       allow delete: if request.auth != null
                && (isVenueOwner(venueId) || isAdmin());
     }

     match /venues/{venueId}/menu_images/{fileName} {
       allow read: if true;

       allow create, update: if request.auth != null
                      && isValidImage()
                      && (isVenueOwner(venueId) || isAdmin());

       allow delete: if request.auth != null
                && (isVenueOwner(venueId) || isAdmin());
    }

    match /venues/{venueId}/stories/{fileName} {
       allow read: if true;

       allow create, update: if request.auth != null
                             && isValidStoryMedia()
                             && isVenueOwner(venueId);

       allow delete: if request.auth != null
                     && isVenueOwner(venueId);
    }

    match /venues/{venueId}/wallet_topups/{fileName} {
       allow read: if request.auth != null && (isVenueOwner(venueId) || isAdmin());

       allow create, update: if request.auth != null
                             && isValidImage()
                             && isVenueOwner(venueId);

       // Top-up proofs are financial evidence; lifecycle deletion must run through
       // audited server-side maintenance, not direct client Storage deletes.
       allow delete: if false;
    }

    // Default: Block all other writes
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
